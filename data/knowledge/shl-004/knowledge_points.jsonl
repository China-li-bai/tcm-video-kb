{"kp_id": "shl-004.kp0038", "video_id": "shl-004", "type": "clause_interpretation", "statement": "第248条：太阳病三日发汗不解蒸蒸发热属胃，调胃承气汤。", "entity_ids": ["clause.shl.248", "formula.diao_wei_cheng_qi_tang"], "chapter_id": "shl-004.c17", "evidence_quote": "三日发汗不解，真蒸发热者属胃炎，调胃承气汤", "seg_from": 2628, "seg_to": 2631, "start_s": 14901.645, "end_s": 14921.62, "citation": {"youtube_id": "nw-b_iqBXCg", "url": "https://www.youtube.com/watch?v=nw-b_iqBXCg&t=14901s", "series": "shl", "episode": 4, "title": "倪海廈《傷寒論》細分版： 4陽明症", "start_s": 14901.65, "end_s": 14921.62}, "confidence": 0.9, "asr_note": "真蒸=蒸蒸；胃炎=胃", "source": "llm_read"}

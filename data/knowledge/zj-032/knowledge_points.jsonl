{"kp_id": "zj-032.kp0004", "video_id": "zj-032", "type": "contraindication", "statement": "肩井在肩峰最高处，可针但勿过深，其下为肺尖，深刺有气胸之虞。", "entity_ids": ["acupoint.gb21"], "chapter_id": "zj-032.c02", "evidence_quote": "下身太深的话就肺虚肿", "seg_from": 110, "seg_to": 111, "start_s": 545.0, "end_s": 577.955, "citation": {"youtube_id": "lDF3EoW9XA4", "url": "https://www.youtube.com/watch?v=lDF3EoW9XA4&t=545s", "series": "zj", "episode": 32, "title": "倪海厦《人纪》《针灸》全90集 之 针灸 32", "start_s": 545.0, "end_s": 577.96}, "confidence": 0.9, "asr_note": "肩颈=肩井；肺虚肿=气胸/肺伤", "source": "llm_read"}

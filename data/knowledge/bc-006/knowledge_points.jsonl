{"kp_id": "bc-006.kp0010", "video_id": "bc-006", "type": "clinical_tip", "statement": "黄芪气药，补虚劳；人参价贵可用黄芪代补气。", "entity_ids": ["herb.huang_qi", "herb.ren_shen"], "chapter_id": "bc-006.c05", "evidence_quote": "我用黄芪", "seg_from": 963, "seg_to": 963, "start_s": 5421.075, "end_s": 5431.575, "citation": {"youtube_id": "jMoDrrLb6CQ", "url": "https://www.youtube.com/watch?v=jMoDrrLb6CQ&t=5421s", "series": "bc", "episode": 6, "title": "倪海廈精解 神農本草經之3 完整重製版 全68篇", "start_s": 5421.07, "end_s": 5431.57}, "confidence": 0.95, "asr_note": "", "source": "llm_read"}
{"kp_id": "bc-006.kp0011", "video_id": "bc-006", "type": "clinical_tip", "statement": "黄芪大补脾、通利三焦；疮口不敛、糖尿病足破溃可托脓生肌。", "entity_ids": ["herb.huang_qi"], "chapter_id": "bc-006.c05", "evidence_quote": "用黄芪把它提升上来", "seg_from": 994, "seg_to": 994, "start_s": 5604.485, "end_s": 5611.77, "citation": {"youtube_id": "jMoDrrLb6CQ", "url": "https://www.youtube.com/watch?v=jMoDrrLb6CQ&t=5604s", "series": "bc", "episode": 6, "title": "倪海廈精解 神農本草經之3 完整重製版 全68篇", "start_s": 5604.48, "end_s": 5611.77}, "confidence": 0.9, "asr_note": "", "source": "llm_read"}

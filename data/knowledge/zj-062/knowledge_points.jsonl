{"kp_id": "zj-062.kp0001", "video_id": "zj-062", "type": "concept_definition", "statement": "本穴=与该经五行属性相同之穴；胆木本穴为足临泣。", "entity_ids": ["acupoint.gb41", "meridian.gb"], "chapter_id": "zj-062.c01", "evidence_quote": "我们叫做本穴", "seg_from": 3, "seg_to": 4, "start_s": 42.41, "end_s": 56.95, "citation": {"youtube_id": "fZ_mjY7H7Cc", "url": "https://www.youtube.com/watch?v=fZ_mjY7H7Cc&t=42s", "series": "zj", "episode": 62, "title": "倪海厦《人纪》《针灸》全90集 之 针灸 62", "start_s": 42.41, "end_s": 56.95}, "confidence": 0.95, "asr_note": "灵气=足临泣", "source": "llm_read"}
{"kp_id": "zj-062.kp0002", "video_id": "zj-062", "type": "acupoint_usage", "statement": "五脏交经：在本穴上用青龙摆尾加强补泻，使气达脏；三阴交可行之以止经痛。", "entity_ids": ["method.bu_xie", "acupoint.sp6"], "chapter_id": "zj-062.c01", "evidence_quote": "用七龙摆尾来做他的补泻", "seg_from": 22, "seg_to": 28, "start_s": 172.37, "end_s": 206.24, "citation": {"youtube_id": "fZ_mjY7H7Cc", "url": "https://www.youtube.com/watch?v=fZ_mjY7H7Cc&t=172s", "series": "zj", "episode": 62, "title": "倪海厦《人纪》《针灸》全90集 之 针灸 62", "start_s": 172.37, "end_s": 206.24}, "confidence": 0.9, "asr_note": "七龙=青龙", "source": "llm_read"}
{"kp_id": "zj-062.kp0003", "video_id": "zj-062", "type": "clinical_tip", "statement": "通关交经用于关节伤后气不过；加强时用赤凤摇头（泻法）。", "entity_ids": ["method.bu_xie"], "chapter_id": "zj-062.c02", "evidence_quote": "刺凤摇头", "seg_from": 39, "seg_to": 41, "start_s": 257.82, "end_s": 290.015, "citation": {"youtube_id": "fZ_mjY7H7Cc", "url": "https://www.youtube.com/watch?v=fZ_mjY7H7Cc&t=257s", "series": "zj", "episode": 62, "title": "倪海厦《人纪》《针灸》全90集 之 针灸 62", "start_s": 257.82, "end_s": 290.01}, "confidence": 0.9, "asr_note": "刺凤=赤凤", "source": "llm_read"}

{"kp_id": "zj-020.kp0001", "video_id": "zj-020", "type": "concept_definition", "statement": "五脏六腑之气皆出自胃；有胃气则有生化之源。", "entity_ids": ["zangfu.wei"], "chapter_id": "zj-020.c01", "evidence_quote": "五脏六腑的气通通出自胃", "seg_from": 1, "seg_to": 2, "start_s": 4.2, "end_s": 11.64, "citation": {"youtube_id": "NOEhIxpi4Pw", "url": "https://www.youtube.com/watch?v=NOEhIxpi4Pw&t=4s", "series": "zj", "episode": 20, "title": "倪海厦《人纪》《针灸》全90集 之 针灸 20", "start_s": 4.2, "end_s": 11.64}, "confidence": 0.95, "asr_note": "", "source": "llm_read"}
{"kp_id": "zj-020.kp0002", "video_id": "zj-020", "type": "concept_definition", "statement": "足阳明胃经凡四十五穴，属多气多血之经。", "entity_ids": ["meridian.st"], "chapter_id": "zj-020.c01", "evidence_quote": "足万面胃经，有四十五个穴道", "seg_from": 5, "seg_to": 9, "start_s": 24.32, "end_s": 49.21, "citation": {"youtube_id": "NOEhIxpi4Pw", "url": "https://www.youtube.com/watch?v=NOEhIxpi4Pw&t=24s", "series": "zj", "episode": 20, "title": "倪海厦《人纪》《针灸》全90集 之 针灸 20", "start_s": 24.32, "end_s": 49.21}, "confidence": 0.95, "asr_note": "万面=阳明", "source": "llm_read"}
{"kp_id": "zj-020.kp0003", "video_id": "zj-020", "type": "acupoint_usage", "statement": "头维在神庭旁开（额角发际）；为足阳明与少阳二脉之会。", "entity_ids": ["acupoint.st8", "acupoint.gv24"], "chapter_id": "zj-020.c01", "evidence_quote": "头尾穴呢是足阳明，汉族少阳的二脉之慧", "seg_from": 38, "seg_to": 41, "start_s": 175.37, "end_s": 203.815, "citation": {"youtube_id": "NOEhIxpi4Pw", "url": "https://www.youtube.com/watch?v=NOEhIxpi4Pw&t=175s", "series": "zj", "episode": 20, "title": "倪海厦《人纪》《针灸》全90集 之 针灸 20", "start_s": 175.37, "end_s": 203.81}, "confidence": 0.85, "asr_note": "头尾=头维；汉族=与足；慧=会", "source": "llm_read"}
{"kp_id": "zj-020.kp0004", "video_id": "zj-020", "type": "acupoint_usage", "statement": "下关主中耳炎流脓、下颌/牙齿脱臼；复位时以下关为主，面痛可配对侧合谷。", "entity_ids": ["acupoint.st7", "new.disease.中耳炎", "acupoint.li4"], "chapter_id": "zj-020.c01", "evidence_quote": "主要质证呢就是中耳炎耳朵里面化脓发炎", "seg_from": 56, "seg_to": 81, "start_s": 275.12, "end_s": 402.205, "citation": {"youtube_id": "NOEhIxpi4Pw", "url": "https://www.youtube.com/watch?v=NOEhIxpi4Pw&t=275s", "series": "zj", "episode": 20, "title": "倪海厦《人纪》《针灸》全90集 之 针灸 20", "start_s": 275.12, "end_s": 402.2}, "confidence": 0.9, "asr_note": "质证=主治", "source": "llm_read"}
{"kp_id": "zj-020.kp0005", "video_id": "zj-020", "type": "acupoint_usage", "statement": "口眼歪斜常用地仓透颊车：自嘴角旁开约五分进针透向颊车；可先下合谷再透。", "entity_ids": ["acupoint.st4", "acupoint.st6", "new.disease.口眼歪斜"], "chapter_id": "zj-020.c02", "evidence_quote": "地仓透夹车", "seg_from": 90, "seg_to": 103, "start_s": 437.29, "end_s": 501.755, "citation": {"youtube_id": "NOEhIxpi4Pw", "url": "https://www.youtube.com/watch?v=NOEhIxpi4Pw&t=437s", "series": "zj", "episode": 20, "title": "倪海厦《人纪》《针灸》全90集 之 针灸 20", "start_s": 437.29, "end_s": 501.75}, "confidence": 0.95, "asr_note": "夹车/甲车/假车=颊车；中封=中风", "source": "llm_read"}

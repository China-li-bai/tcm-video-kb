{"kp_id": "zj-025.kp0001", "video_id": "zj-025", "type": "concept_definition", "statement": "思虑过重可伤脾；脾主味觉，脾伤则味觉减退。", "entity_ids": ["zangfu.pi"], "chapter_id": "zj-025.c01", "evidence_quote": "思虑很重，脾脏会受伤", "seg_from": 52, "seg_to": 53, "start_s": 271.89, "end_s": 284.745, "citation": {"youtube_id": "PQ3MHojvV2s", "url": "https://www.youtube.com/watch?v=PQ3MHojvV2s&t=271s", "series": "zj", "episode": 25, "title": "倪海厦《人纪》《针灸》全90集 之 针灸 25", "start_s": 271.89, "end_s": 284.75}, "confidence": 0.9, "asr_note": "伤贫=伤脾", "source": "llm_read"}
{"kp_id": "zj-025.kp0002", "video_id": "zj-025", "type": "acupoint_usage", "statement": "隐白在足大趾甲旁，为脾经井穴；井穴刺激强，可用于气陷等。", "entity_ids": ["acupoint.sp1", "meridian.sp"], "chapter_id": "zj-025.c01", "evidence_quote": "第一个穴隐白是井穴", "seg_from": 91, "seg_to": 108, "start_s": 463.29, "end_s": 567.84, "citation": {"youtube_id": "PQ3MHojvV2s", "url": "https://www.youtube.com/watch?v=PQ3MHojvV2s&t=463s", "series": "zj", "episode": 25, "title": "倪海厦《人纪》《针灸》全90集 之 针灸 25", "start_s": 463.29, "end_s": 567.84}, "confidence": 0.95, "asr_note": "", "source": "llm_read"}
{"kp_id": "zj-025.kp0003", "video_id": "zj-025", "type": "acupoint_usage", "statement": "灸大趾三毛可治失眠，有人灸中即睡。", "entity_ids": ["new.acupoint.三毛"], "chapter_id": "zj-025.c01", "evidence_quote": "灸三毛是嘛的专门治疗失眠", "seg_from": 129, "seg_to": 132, "start_s": 647.47, "end_s": 667.805, "citation": {"youtube_id": "PQ3MHojvV2s", "url": "https://www.youtube.com/watch?v=PQ3MHojvV2s&t=647s", "series": "zj", "episode": 25, "title": "倪海厦《人纪》《针灸》全90集 之 针灸 25", "start_s": 647.47, "end_s": 667.8}, "confidence": 0.85, "asr_note": "鸠三毛=灸三毛", "source": "llm_read"}
{"kp_id": "zj-025.kp0004", "video_id": "zj-025", "type": "concept_definition", "statement": "大都为脾经荥穴，阴经荥属火，火生土故为母穴一类用法。", "entity_ids": ["acupoint.sp2"], "chapter_id": "zj-025.c01", "evidence_quote": "溶器是属是属于火火生土嘛", "seg_from": 163, "seg_to": 168, "start_s": 818.24, "end_s": 847.545, "citation": {"youtube_id": "PQ3MHojvV2s", "url": "https://www.youtube.com/watch?v=PQ3MHojvV2s&t=818s", "series": "zj", "episode": 25, "title": "倪海厦《人纪》《针灸》全90集 之 针灸 25", "start_s": 818.24, "end_s": 847.54}, "confidence": 0.85, "asr_note": "溶器=荥穴；皮筋=脾经", "source": "llm_read"}

{"kp_id": "zj-025.kp0006", "video_id": "zj-025", "type": "acupoint_usage", "statement": "公孙配内关治诸胃病，效常立竿见影；公孙为脾经络穴，通冲脉。", "entity_ids": ["acupoint.sp4", "acupoint.pc6", "concept.luo_xue", "meridian.tv"], "chapter_id": "zj-025.c02", "evidence_quote": "公孙穴配上内关", "seg_from": 294, "seg_to": 339, "start_s": 1432.221, "end_s": 1687.496, "citation": {"youtube_id": "PQ3MHojvV2s", "url": "https://www.youtube.com/watch?v=PQ3MHojvV2s&t=1432s", "series": "zj", "episode": 25, "title": "倪海厦《人纪》《针灸》全90集 之 针灸 25", "start_s": 1432.22, "end_s": 1687.5}, "confidence": 0.95, "asr_note": "崇拜=冲脉；落穴=络穴", "source": "llm_read"}

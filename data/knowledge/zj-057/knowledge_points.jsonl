{"kp_id": "zj-057.kp0001", "video_id": "zj-057", "type": "concept_definition", "statement": "阳维主外用外关，阴维主内用内关；外关透内关使阴阳交合。", "entity_ids": ["meridian.yinlv", "meridian.yanglv", "acupoint.pc6", "acupoint.te5"], "chapter_id": "zj-057.c01", "evidence_quote": "内关", "seg_from": 5, "seg_to": 6, "start_s": 36.22, "end_s": 52.68, "citation": {"youtube_id": "HMQcxDE7B1k", "url": "https://www.youtube.com/watch?v=HMQcxDE7B1k&t=36s", "series": "zj", "episode": 57, "title": "倪海厦《人纪》《针灸》全90集 之 针灸 57", "start_s": 36.22, "end_s": 52.68}, "confidence": 0.9, "asr_note": "阳痿/阳为=阳维；阴为=阴维；外观=外关", "source": "llm_read"}
{"kp_id": "zj-057.kp0002", "video_id": "zj-057", "type": "clinical_tip", "statement": "针刺先求引气（酸麻胀），再谈补泻手法。", "entity_ids": ["method.bu_xie"], "chapter_id": "zj-057.c02", "evidence_quote": "引气", "seg_from": 38, "seg_to": 38, "start_s": 227.55, "end_s": 228.63, "citation": {"youtube_id": "HMQcxDE7B1k", "url": "https://www.youtube.com/watch?v=HMQcxDE7B1k&t=227s", "series": "zj", "episode": 57, "title": "倪海厦《人纪》《针灸》全90集 之 针灸 57", "start_s": 227.55, "end_s": 228.63}, "confidence": 0.9, "asr_note": "", "source": "llm_read"}
{"kp_id": "zj-057.kp0003", "video_id": "zj-057", "type": "clinical_tip", "statement": "烧山火大补治里寒；透天凉大泻治大热；补法紧按慢提。", "entity_ids": ["new.method.shao_shan_huo", "new.method.tou_tian_liang"], "chapter_id": "zj-057.c02", "evidence_quote": "透天凉", "seg_from": 147, "seg_to": 148, "start_s": 776.34, "end_s": 783.255, "citation": {"youtube_id": "HMQcxDE7B1k", "url": "https://www.youtube.com/watch?v=HMQcxDE7B1k&t=776s", "series": "zj", "episode": 57, "title": "倪海厦《人纪》《针灸》全90集 之 针灸 57", "start_s": 776.34, "end_s": 783.25}, "confidence": 0.95, "asr_note": "透天鸟=透天凉", "source": "llm_read"}
{"kp_id": "zj-057.kp0004", "video_id": "zj-057", "type": "diagnostic_rule", "statement": "先寒后热为阳中引阴（先补后泻）；先热后寒为阴中引阳（先泻后补）。", "entity_ids": ["method.bu_xie"], "chapter_id": "zj-057.c03", "evidence_quote": "先补后泻", "seg_from": 288, "seg_to": 291, "start_s": 1465.903, "end_s": 1483.788, "citation": {"youtube_id": "HMQcxDE7B1k", "url": "https://www.youtube.com/watch?v=HMQcxDE7B1k&t=1465s", "series": "zj", "episode": 57, "title": "倪海厦《人纪》《针灸》全90集 之 针灸 57", "start_s": 1465.9, "end_s": 1483.79}, "confidence": 0.9, "asr_note": "先卸后补=先泻后补", "source": "llm_read"}
{"kp_id": "zj-057.kp0005", "video_id": "zj-057", "type": "clinical_tip", "statement": "寒多热少或酸多痛少先补后泻；问清寒热/酸痛多少再定手法。", "entity_ids": ["method.bu_xie", "acupoint.te7"], "chapter_id": "zj-057.c03", "evidence_quote": "会宗", "seg_from": 294, "seg_to": 311, "start_s": 1499.493, "end_s": 1598.918, "citation": {"youtube_id": "HMQcxDE7B1k", "url": "https://www.youtube.com/watch?v=HMQcxDE7B1k&t=1499s", "series": "zj", "episode": 57, "title": "倪海厦《人纪》《针灸》全90集 之 针灸 57", "start_s": 1499.49, "end_s": 1598.92}, "confidence": 0.85, "asr_note": "", "source": "llm_read"}

{"kp_id": "zj-008.kp0001", "video_id": "zj-008", "type": "acupoint_usage", "statement": "关元为小肠募穴，气所归藏；虚证可灸，但艾火勿过斜以防烫伤。", "entity_ids": ["acupoint.cv4", "concept.mu_xue", "zangfu.xiao_chang"], "chapter_id": "zj-008.c01", "evidence_quote": "小肠的墓穴，是气降下去的成累积的地方", "seg_from": 4, "seg_to": 128, "start_s": 20.17, "end_s": 690.005, "citation": {"youtube_id": "AEA5l6ymoO4", "url": "https://www.youtube.com/watch?v=AEA5l6ymoO4&t=20s", "series": "zj", "episode": 8, "title": "倪海厦《人纪》《针灸》全90集 之 针灸 08", "start_s": 20.17, "end_s": 690.0}, "confidence": 0.9, "asr_note": "墓=募", "source": "llm_read"}

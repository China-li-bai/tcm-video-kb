{"kp_id": "jgy-011.kp0001", "video_id": "jgy-011", "type": "clinical_tip", "statement": "金匮第十篇分腹满、寒疝、宿食三纲；腹满须先辨虚实。", "entity_ids": ["symptom.fu_man"], "chapter_id": "jgy-011.c01", "evidence_quote": "腹满", "seg_from": 0, "seg_to": 0, "start_s": 3.58, "end_s": 9.18, "citation": {"youtube_id": "9fhn6KVoHFM", "url": "https://www.youtube.com/watch?v=9fhn6KVoHFM&t=3s", "series": "jgy", "episode": 11, "title": "倪海廈《金匱要略》細分版： 10腹滿寒疝氣宿食病", "start_s": 3.58, "end_s": 9.18}, "confidence": 0.95, "asr_note": "寒散=寒疝；肃食=宿食", "source": "llm_read"}

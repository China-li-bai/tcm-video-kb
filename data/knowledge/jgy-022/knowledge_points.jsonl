{"kp_id": "jgy-022.kp0015", "video_id": "jgy-022", "type": "diagnostic_rule", "statement": "产后面正赤喘头痛：实热白虎面赤光亮；虚热粉红无光，用竹叶汤（含附子）。", "entity_ids": ["formula.zhu_ye_tang", "formula.bai_hu_tang"], "chapter_id": "jgy-022.c03", "evidence_quote": "虚热的脸红是粉红的", "seg_from": 198, "seg_to": 198, "start_s": 1174.131, "end_s": 1181.316, "citation": {"youtube_id": "1C6RSxE27YY", "url": "https://www.youtube.com/watch?v=1C6RSxE27YY&t=1174s", "series": "jgy", "episode": 22, "title": "倪海廈《金匱要略》細分版： 21婦人產後病", "start_s": 1174.13, "end_s": 1181.32}, "confidence": 0.95, "asr_note": "", "source": "llm_read"}

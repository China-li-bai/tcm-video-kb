{"kp_id": "jgy-016.kp0001", "video_id": "jgy-016", "type": "clinical_tip", "statement": "金匮黄疸篇黄瘅可读丹或淡，即黄色病；黄汗并非真正发黄之病。", "entity_ids": ["disease.huang_dan", "syndrome.huang_han"], "chapter_id": "jgy-016.c01", "evidence_quote": "黄色的", "seg_from": 5, "seg_to": 5, "start_s": 17.2, "end_s": 22.62, "citation": {"youtube_id": "rt0S4kpiRF8", "url": "https://www.youtube.com/watch?v=rt0S4kpiRF8&t=17s", "series": "jgy", "episode": 16, "title": "倪海廈《金匱要略》細分版： 15黃瘅病", "start_s": 17.2, "end_s": 22.62}, "confidence": 0.95, "asr_note": "", "source": "llm_read"}
{"kp_id": "jgy-016.kp0002", "video_id": "jgy-016", "type": "diagnostic_rule", "statement": "黄疸分阳黄与阴黄：阳黄鲜亮如橘，约十日可愈；阴黄晦暗，较难治。", "entity_ids": ["disease.huang_dan", "new.pattern.yang_huang", "new.pattern.yin_huang"], "chapter_id": "jgy-016.c01", "evidence_quote": "阳黄", "seg_from": 8, "seg_to": 8, "start_s": 31.0, "end_s": 41.28, "citation": {"youtube_id": "rt0S4kpiRF8", "url": "https://www.youtube.com/watch?v=rt0S4kpiRF8&t=31s", "series": "jgy", "episode": 16, "title": "倪海廈《金匱要略》細分版： 15黃瘅病", "start_s": 31.0, "end_s": 41.28}, "confidence": 0.95, "asr_note": "", "source": "llm_read"}

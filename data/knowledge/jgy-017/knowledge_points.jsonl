{"kp_id": "jgy-017.kp0001", "video_id": "jgy-017", "type": "clinical_tip", "statement": "金匮第十六篇统论惊悸、吐衄、下血、胸满、瘀血诸证。", "entity_ids": ["disease.jing_ji", "symptom.xia_xue", "symptom.xiong_man", "disease.yu_xue"], "chapter_id": "jgy-017.c01", "evidence_quote": "下血", "seg_from": 1, "seg_to": 1, "start_s": 2.81, "end_s": 16.93, "citation": {"youtube_id": "mABsoFItvwo", "url": "https://www.youtube.com/watch?v=mABsoFItvwo&t=2s", "series": "jgy", "episode": 17, "title": "倪海廈《金匱要略》細分版： 16驚悸吐衄下血胸滿瘀血病", "start_s": 2.81, "end_s": 16.93}, "confidence": 0.95, "asr_note": "经悸=惊悸；吐拗=吐衄；淤血=瘀血", "source": "llm_read"}

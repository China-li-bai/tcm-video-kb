{"kp_id": "jgy-017.kp0010", "video_id": "jgy-017", "type": "diagnostic_rule", "statement": "瘀血证：胸满、唇萎、舌青、口燥但欲漱水不欲咽，无表寒热；舌边齿痕、舌瘀点、少腹压痛可佐。", "entity_ids": ["disease.yu_xue", "symptom.xiong_man", "zangfu.pi"], "chapter_id": "jgy-017.c03", "evidence_quote": "胸满", "seg_from": 285, "seg_to": 285, "start_s": 1706.59, "end_s": 1711.155, "citation": {"youtube_id": "mABsoFItvwo", "url": "https://www.youtube.com/watch?v=mABsoFItvwo&t=1706s", "series": "jgy", "episode": 17, "title": "倪海廈《金匱要略》細分版： 16驚悸吐衄下血胸滿瘀血病", "start_s": 1706.59, "end_s": 1711.15}, "confidence": 0.95, "asr_note": "猪淤汤=诸瘀；唇萎/唇尾=唇萎；内由于=内有瘀", "source": "llm_read"}

{"kp_id": "zj-031.kp0002", "video_id": "zj-031", "type": "acupoint_usage", "statement": "少泽为小肠井穴，平常多点刺放血。", "entity_ids": ["acupoint.si1", "new.method.点刺放血"], "chapter_id": "zj-031.c01", "evidence_quote": "少则穴，它是井穴", "seg_from": 98, "seg_to": 105, "start_s": 556.23, "end_s": 591.17, "citation": {"youtube_id": "cYoIZLoUziQ", "url": "https://www.youtube.com/watch?v=cYoIZLoUziQ&t=556s", "series": "zj", "episode": 31, "title": "倪海厦《人纪》《针灸》全90集 之 针灸 31", "start_s": 556.23, "end_s": 591.17}, "confidence": 0.9, "asr_note": "少则=少泽；颈穴=井穴", "source": "llm_read"}
{"kp_id": "zj-031.kp0003", "video_id": "zj-031", "type": "acupoint_usage", "statement": "前谷在握拳横纹头，为荥属水；治乳汁不足，未时精神差亦可取（较痛）。", "entity_ids": ["acupoint.si2"], "chapter_id": "zj-031.c01", "evidence_quote": "恒纹头就是我们的前谷穴", "seg_from": 117, "seg_to": 136, "start_s": 634.28, "end_s": 734.61, "citation": {"youtube_id": "cYoIZLoUziQ", "url": "https://www.youtube.com/watch?v=cYoIZLoUziQ&t=634s", "series": "zj", "episode": 31, "title": "倪海厦《人纪》《针灸》全90集 之 针灸 31", "start_s": 634.28, "end_s": 734.61}, "confidence": 0.95, "asr_note": "恒纹=横纹", "source": "llm_read"}
{"kp_id": "zj-031.kp0004", "video_id": "zj-031", "type": "acupoint_usage", "statement": "后溪通督脉，又为小肠输穴/母穴；脊痛配督脉穴，小肠虚证及肩痛常取后溪。", "entity_ids": ["acupoint.si3", "meridian.gv", "meridian.si"], "chapter_id": "zj-031.c02", "evidence_quote": "后溪穴呢是主督脉，身上的督脉呢是后溪在管", "seg_from": 143, "seg_to": 161, "start_s": 772.43, "end_s": 894.81, "citation": {"youtube_id": "cYoIZLoUziQ", "url": "https://www.youtube.com/watch?v=cYoIZLoUziQ&t=772s", "series": "zj", "episode": 31, "title": "倪海厦《人纪》《针灸》全90集 之 针灸 31", "start_s": 772.43, "end_s": 894.81}, "confidence": 0.95, "asr_note": "", "source": "llm_read"}

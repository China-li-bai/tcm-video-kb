{"kp_id": "jgy-021.kp0011", "video_id": "jgy-021", "type": "diagnostic_rule", "statement": "妊娠见弦脉主里寒；少腹如扇、腹胀急而恶寒为胞中寒。", "entity_ids": ["formula.fu_zi_tang"], "chapter_id": "jgy-021.c04", "evidence_quote": "玄脉", "seg_from": 167, "seg_to": 167, "start_s": 1000.68, "end_s": 1001.98, "citation": {"youtube_id": "z4o9zRl7AUM", "url": "https://www.youtube.com/watch?v=z4o9zRl7AUM&t=1000s", "series": "jgy", "episode": 21, "title": "倪海廈《金匱要略》細分版： 20婦人妊娠病", "start_s": 1000.68, "end_s": 1001.98}, "confidence": 0.85, "asr_note": "玄脉=弦脉", "source": "llm_read"}
{"kp_id": "jgy-021.kp0012", "video_id": "jgy-021", "type": "formula_indication", "statement": "妊娠胞中寒水、腹胀如鼓、恶寒如扇，用附子汤温里祛寒利水，胀消溲利即止。", "entity_ids": ["formula.fu_zi_tang", "herb.fu_zi", "herb.bai_zhu", "herb.fu_ling"], "chapter_id": "jgy-021.c04", "evidence_quote": "附子汤", "seg_from": 178, "seg_to": 178, "start_s": 1039.74, "end_s": 1045.055, "citation": {"youtube_id": "z4o9zRl7AUM", "url": "https://www.youtube.com/watch?v=z4o9zRl7AUM&t=1039s", "series": "jgy", "episode": 21, "title": "倪海廈《金匱要略》細分版： 20婦人妊娠病", "start_s": 1039.74, "end_s": 1045.06}, "confidence": 0.95, "asr_note": "父子汤=附子汤；白族=白术；白扫=白芍", "source": "llm_read"}

{"kp_id": "zj-045.kp0003", "video_id": "zj-045", "type": "clinical_tip", "statement": "下半身水肿、小便不利：水分、水道等配用（天皇地皇人皇类），消肿较快。", "entity_ids": ["acupoint.cv9", "acupoint.st28"], "chapter_id": "zj-045.c01", "evidence_quote": "三环穴就下去肿就开始消哦", "seg_from": 41, "seg_to": 48, "start_s": 239.41, "end_s": 276.375, "citation": {"youtube_id": "cv5hnRHcwDY", "url": "https://www.youtube.com/watch?v=cv5hnRHcwDY&t=239s", "series": "zj", "episode": 45, "title": "Ni Hai-Hsia \"Human Discipline\" \"Acupuncture\" All 90 Episodes - Acupuncture 45", "start_s": 239.41, "end_s": 276.38}, "confidence": 0.85, "asr_note": "三环=三皇；水稻=水道", "source": "llm_read"}

{"kp_id": "shl-006.kp0021", "video_id": "shl-006", "type": "diagnostic_rule", "statement": "拉肚子而口渴属阳证，一般不死人；拉了还不口渴是阴病，因脏中有寒。", "entity_ids": ["symptom.xia_li", "new.symptom.口渴"], "chapter_id": "shl-006.c04.s1", "evidence_quote": "拉了半天还不口渴，你什么病呢？", "seg_from": 180, "seg_to": 186, "start_s": 1051.37, "end_s": 1079.255, "citation": {"youtube_id": "9zCCln-3KaE", "url": "https://www.youtube.com/watch?v=9zCCln-3KaE&t=1051s", "series": "shl", "episode": 6, "title": "倪海廈《傷寒論》細分版： 6太陰症", "start_s": 1051.37, "end_s": 1079.26}, "confidence": 0.9, "asr_note": "", "source": "llm_read"}

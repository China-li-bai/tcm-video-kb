# Copy to configs/.env (gitignored) — never commit secrets
TCMKB_ROOT=
# R2 (optional for local demo; LocalStorage used when unset)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=tcm-media
R2_ENDPOINT=
# Postgres (unused in local MVP; SQLite at data/state.sqlite)
DATABASE_URL=postgresql://tcmkb:tcmkb@localhost:5432/tcmkb
# LLM for s08 chaptering (optional; heuristic used when unset)
OPENAI_API_KEY=
OPENAI_BASE_URL=
OPENAI_MODEL=gpt-4o-mini

# Site base for absolute cite URLs (optional; relative /watch/... works without it)
TCMKB_SITE_BASE=
# Media CDN / custom domain for play URLs (optional)
TCMKB_MEDIA_BASE=
R2_PUBLIC_BASE=
# Stub / Worker HMAC for play URLs — keep separate from R2_SECRET_ACCESS_KEY
# (falls back to R2_SECRET_ACCESS_KEY with a warning if unset, then "dev")
TCMKB_MEDIA_HMAC_SECRET=
